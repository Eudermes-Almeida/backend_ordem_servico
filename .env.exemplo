# Senha do banco usada pelo backend (application.properties -> ${DB_PASSWORD}).
# Copie para ".env" e preencha. O arquivo .env NUNCA vai para o Git.
DB_PASSWORD=coloque_a_senha_aqui

# Endereço gravado no QR Code das etiquetas (padrão: https://app.somonitores.tec.br/e/).
# Defina ANTES de imprimir etiquetas: o QR impresso não muda depois.
# ETIQUETA_URL_BASE=https://status.somonitores.tec.br/e/

# Link do cliente na mensagem "Interação por WhatsApp" (vazio = o da etiqueta com /e/ trocado por /c/).
# O WhatsApp só deixa clicável link com nome de domínio (IP puro fica como texto).
# CLIENTE_URL_BASE=https://status.somonitores.tec.br/c/
